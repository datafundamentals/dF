# Monorepo .gitignore
# Covers all node_modules directories across all projects

.z_/historical
.z_/WIP
.claude/

# Node.js dependencies
**/node_modules/
node_modules/

# Build outputs
**/dist/
**/out-tsc/
**/build/
**/storybook-static/
dist/
out-tsc/
build/

# Firebase Functions compiled output
apps/df-firebase-teaching-app/functions/lib/

# Environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.emulator
!**/.env.production.example
packages/state/src/stores/google-auth-config.ts
# .env.development is a symlink to .env.emulator (excluded but kept for Vite)
.env
.env.*
!.env.example
!.env.emulator
!.env.production.example

# Logs
**/*.log
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Cache directories
**/.cache/
**/.npm/
**/.eslintcache
**/.stylelintcache
**/.parcel-cache
.turbo/
.turbo
.cache/
.npm/

# IDE files
**/.vscode/
**/.idea/
.vscode/
.idea/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project-specific ignores
apps/*/chromadata/
apps/*/playwright-report/
apps/*/test-results/
shared/dist/

# TypeScript
**/*.tsbuildinfo
*.tsbuildinfo

# Test coverage reports
**/coverage/
coverage/

# Firebase Emulator runtime/cache (NOT the seed data)
**/.firebase/
**/firebase-debug.log
**/firestore-debug.log
**/ui-debug.log
**/database-debug.log
**/pubsub-debug.log

# Firebase Emulator exported data (regenerate with seed script)
**/emulator-data/
apps/df-firebase-teaching-app/emulator-data/
apps/df-firebase-teaching-app/firebase-export-*/

# Firebase Teaching App - Generated seed files
# These are auto-generated by the seed script but can be manually overridden
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/images/*.svg
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/images/*.png
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/images/*.jpg
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/documents/*.txt
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/documents/*.md
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/documents/*.json
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/avatars/*.svg
apps/df-firebase-teaching-app/scripts/seed-data/storage-files/avatars/*.png
# Keep .gitkeep files
!apps/df-firebase-teaching-app/scripts/seed-data/storage-files/**/.gitkeep

# Package manager
**/package-lock.json.bak
**/yarn.lock.bak
