# Firebase Teaching App - Environment Configuration Template
# Copy this file to .env.emulator for local development

# Firebase Project Configuration
# These are placeholder values for emulator development
# Emulators do not validate these values, so any valid format works
VITE_FIREBASE_API_KEY=demo-api-key-for-emulator-development
VITE_FIREBASE_AUTH_DOMAIN=demo-auth-function-tool.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-auth-function-tool
VITE_FIREBASE_STORAGE_BUCKET=demo-auth-function-tool.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123def456789

# Environment Mode
# Set to 'true' for local emulator development (offline)
# Set to 'false' for production Firebase (requires real credentials above)
VITE_USE_EMULATOR=true

# Emulator UI URL (optional override)
# Default: http://127.0.0.1:5410
# Only used when VITE_USE_EMULATOR=true
VITE_FIREBASE_EMULATOR_UI=http://127.0.0.1:5410
