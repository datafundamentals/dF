# Firebase Development Environment Configuration
# Template file for developers setting up a new app
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.development
# 2. Replace the Firebase credentials below with your own from Firebase Console
# 3. Keep VITE_USE_EMULATOR=true to use local emulators for Firestore/Storage/Functions
#
# IMPORTANT: This file should contain REAL Firebase credentials because Auth never uses emulators.
# Only Firestore, Storage, and Functions will connect to local emulators.

# Firebase Project Configuration (REAL CREDENTIALS FOR AUTH)
# Get these values from Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your-real-api-key-from-firebase-console
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Emulator Mode
# Set to 'true' to use local emulators for Firestore, Storage, Functions
# Set to 'false' to use live Firebase for all services
# Auth always uses the real Firebase project (see credentials above)
VITE_USE_EMULATOR=true

# Emulator UI URL (optional override)
# Default: http://127.0.0.1:5400
# Only used when VITE_USE_EMULATOR=true
VITE_FIREBASE_EMULATOR_UI=http://127.0.0.1:5400
