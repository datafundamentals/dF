{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9155
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9390
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5500
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5400
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "unsafe-none"
          }
        ]
      }
    ]
  }
}
