{
  "name": "@df/df-app-starter-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:prod": "vite build --mode production",
    "build:bundle": "vite build --mode production",
    "build:rollup": "pnpm clean && pnpm build && rollup -c",
    "dev": "vite",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "serve": "vite",
    "start:test": "pnpm build && vite dev --strictPort --mode test --logLevel error",
    "pretest": "pnpm build",
    "test": "pnpm test:integration",
    "test:integration": "playwright test --config ../../playwright.config.ts --project=df-app-starter-template",
    "test:rules": "tsx ./tests/security-rules/run-all-tests.ts",
    "test:seed-data": "pnpm --filter @df/firebase-emulator test:seed-data",
    "emulators:start": "echo '⚠️  Please run \"pnpm emulators:start\" from the repo root. See guides/firebase-emulator-workflow.md for details.' && exit 1",
    "emulators:clear": "echo '⚠️  Please run \"pnpm emulators:clear\" from the repo root. See guides/firebase-emulator-workflow.md for details.' && exit 1",
    "seed": "pnpm --filter @df/firebase-emulator seed",
    "seed:reset": "pnpm --filter @df/firebase-emulator seed:reset",
    "deploy:rules": "cd ../.. && firebase deploy --only firestore:rules,storage",
    "deploy:functions": "cd ../.. && firebase deploy --only functions",
    "deploy:prod": "pnpm test:rules && pnpm build:prod && cd ../.. && firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@df/firebase": "workspace:*",
    "@df/state": "workspace:*",
    "@df/ui-lit": "workspace:*",
    "@lit-labs/signals": "^0.1.0",
    "@material/web": "^2.4.0",
    "firebase": "^11.7.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "firebase-tools": "^13.29.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.21.3",
    "rollup-plugin-summary": "^2.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.10"
  }
}
