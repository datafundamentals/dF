{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "../../services/auth-functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --filter @df/auth-functions run build"
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9156
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "ui": {
      "host": "127.0.0.1",
      "port": 5410
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
