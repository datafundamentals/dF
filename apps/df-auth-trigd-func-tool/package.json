{
  "name": "@df/df-auth-trigd-func-tool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:prod": "vite build --mode production",
    "build:bundle": "vite build --mode production",
    "dev": "vite --mode production",
    "preview": "vite preview --host 127.0.0.1 --port 4186",
    "preview:prod": "vite preview --mode production --host 127.0.0.1 --port 4186",
    "serve": "vite",
    "start:test": "pnpm build && vite dev --host 127.0.0.1 --port 4186 --strictPort --mode test --logLevel error",
    "pretest": "pnpm build",
    "test": "pnpm test:integration",
    "test:integration": "playwright test --config ../../playwright.config.ts --project=df-auth-trigd-func-tool",
    "emulators:start": "pnpm --filter @df/firebase-emulator ensure-ports && firebase emulators:start --project demo-auth-function-tool --import ../../packages/firebase-emulator/emulator-data --export-on-exit ../../packages/firebase-emulator/emulator-data --only auth,firestore,functions",
    "emulators:clear": "pnpm --filter @df/firebase-emulator emulators:clear",
    "seed": "AUTH_EMULATOR_PORT=9156 pnpm --filter @df/firebase-emulator seed:auth-only",
    "seed:reset": "AUTH_EMULATOR_PORT=9156 pnpm --filter @df/firebase-emulator seed:auth-only:reset",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@df/firebase": "workspace:*",
    "@df/state": "workspace:*",
    "@df/ui-lit": "workspace:*",
    "@lit-labs/signals": "^0.1.0",
    "@material/web": "^2.4.0",
    "firebase": "^11.7.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.0.0",
    "firebase-tools": "^13.29.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.10"
  }
}
