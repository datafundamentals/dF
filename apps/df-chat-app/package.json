{
  "name": "@df/df-chat-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:prod": "vite build --mode production",
    "build:bundle": "vite build --mode production",
    "build:rollup": "pnpm clean && pnpm build && rollup -c",
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4181",
    "preview:prod": "vite preview --mode production --host 127.0.0.1 --port 4181",
    "start:test": "pnpm build && vite dev --host 127.0.0.1 --port 4181 --strictPort --mode test --logLevel error",
    "pretest": "pnpm build",
    "test": "pnpm test:integration || true",
    "test:integration": "playwright test --config ../../playwright.config.ts --project=df-chat-app",
    "emulators:start": "pnpm --filter @df/firebase-emulator ensure-ports && firebase emulators:start --project peg-2035 --import ../../packages/firebase-emulator/emulator-data --export-on-exit ../../packages/firebase-emulator/emulator-data --only firestore,storage,functions",
    "emulators:clear": "pnpm --filter @df/firebase-emulator emulators:clear"
  },
  "dependencies": {
    "@df/firebase": "workspace:*",
    "@df/state": "workspace:*",
    "@df/ui-lit": "workspace:*",
    "@lit-labs/signals": "^0.1.0",
    "@material/web": "^2.4.0",
    "firebase": "^11.7.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "firebase-tools": "^13.29.1",
    "playwright": "^1.48.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.10"
  }
}
