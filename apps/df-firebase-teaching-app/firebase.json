{
  "_comment": "Emulator ports must mirror packages/firebase/firebase.json (single source of truth). Update shared file + rebuild @df/firebase if ports change.",
  "functions": {
    "source": "../../services/functions",
    "runtime": "nodejs20",
    "predeploy": [
      "pnpm --filter @df/types run build",
      "pnpm --filter @df/functions-shared run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9390
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5501
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5400
    }
  }
}
