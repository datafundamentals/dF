{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "pnpm --filter @df/types run build",
      "pnpm --filter @df/df-firebase-teaching-app-functions run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9390
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5501
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5500
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5400
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "unsafe-none"
          }
        ]
      }
    ]
  }
}
