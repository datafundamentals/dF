# Firebase Production Environment Configuration
# Template file for production deployment
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Replace with your real Firebase credentials
# 3. Ensure VITE_USE_EMULATOR=false (all services use production Firebase)
#
# ⚠️  SECURITY WARNING ⚠️
# - Never commit .env.production to git (it's in .gitignore)
# - Use GitHub Secrets or equivalent for CI/CD
# - Rotate credentials if accidentally exposed

# Firebase Project Configuration (REAL CREDENTIALS)
# Get from: Firebase Console > Project Settings > Your apps > Web app
VITE_FIREBASE_API_KEY=your-real-api-key-from-firebase-console
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Environment Mode
# MUST be 'false' for production deployment (all services use live Firebase)
VITE_USE_EMULATOR=false

# Emulator UI URL (not used in production, but present for build consistency)
VITE_FIREBASE_EMULATOR_UI=http://127.0.0.1:5400
