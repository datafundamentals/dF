# Firebase Teaching App - Production Environment Configuration Template
# This file documents the production configuration pattern
# NOT REQUIRED until Ticket 13 (Production Deployment)

# ⚠️  SECURITY WARNING ⚠️
# When creating .env.production with real values:
# 1. NEVER commit .env.production to git (it's in .gitignore)
# 2. Use GitHub Secrets or equivalent for CI/CD
# 3. Rotate credentials if accidentally exposed

# Firebase Project Configuration
# REPLACE with actual values from Firebase Console
# (Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=your-real-api-key-from-firebase-console
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Environment Mode
# MUST be 'false' for production deployment
VITE_USE_EMULATOR=false

# Emulator UI URL (not used in production, but required by type definitions)
VITE_FIREBASE_EMULATOR_UI=http://127.0.0.1:5400

# How to obtain these values:
# 1. Go to Firebase Console: https://console.firebase.google.com
# 2. Select your project (or create one)
# 3. Click the gear icon > Project settings
# 4. Scroll to "Your apps" section
# 5. Click on your web app (or create one)
# 6. Copy the config values from the code snippet
