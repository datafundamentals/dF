{
  "name": "@df/df-npm-info-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "build:rollup": "pnpm clean && pnpm build && rollup -c",
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "serve": "vite",
    "start:test": "pnpm build && pnpm exec vite dev --host 127.0.0.1 --port 4173 --strictPort --mode test --logLevel error",
    "pretest": "pnpm build",
    "test": "pnpm test:integration",
    "test:integration": "playwright test --config ../../playwright.config.ts --project=df-npm-info-app"
  },
  "dependencies": {
    "@df/state": "workspace:*",
    "@df/ui-lit": "workspace:*",
    "@lit-labs/signals": "^0.1.1",
    "@material/web": "^2.4.0",
    "lit": "^3.3.1",
    "signal-polyfill": "^0.2.2",
    "signal-utils": "^0.21.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@web/test-runner": "^0.20.2",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "dotenv": "^16.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.2"
  },
  "customElements": "custom-elements.json"
}
