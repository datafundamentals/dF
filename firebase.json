{
  "_comment": "Root-level Firebase configuration for deploying shared Firestore security rules. All apps in this monorepo share the same Firebase project and ruleset. Deploy from root: firebase deploy --only firestore:rules",
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "services/functions",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --filter @df/types run build",
      "pnpm --filter @df/functions-shared run build"
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9155
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9390
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5501
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 5400
    }
  },
  "hosting": [
    {
      "target": "df-activity-log",
      "public": "apps/df-activity-log/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "df-chat-app",
      "public": "apps/df-chat-app/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "df-firebase-teaching-app",
      "public": "apps/df-firebase-teaching-app/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "df-user-admin-app",
      "public": "apps/df-user-admin-app/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "df-app-starter-template",
      "public": "apps/df-app-starter-template/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
