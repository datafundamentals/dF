{
  "name": "df-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "apps/*",
    "apps/*/functions",
    "packages/*",
    "services/*",
    "extensions/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm run test:clean-ports && turbo run test",
    "test:clean-ports": "node tools/test-utils/src/clean-test-ports.mjs",
    "test:integration": "playwright test",
    "clean": "turbo run clean && pnpm -r exec rimraf node_modules dist .turbo",
    "scan:compliance": "node tools/compliance/src/check-md3-compliance.mjs",
    "scan:compliance:staged": "node tools/compliance/src/check-md3-compliance.mjs --staged",
    "prepare": "husky install",
    "standards:dashboard": "node tools/compliance/src/dashboard.mjs",
    "generate:compliance-report": "node tools/compliance/src/generate-compliance-report.mjs",
    "scan:compliance:interactive": "node tools/compliance/src/check-md3-compliance.mjs --interactive",
    "deploy:copy-bundle": "node tools/deploy-scripts/src/copy-app-bundle.mjs",
    "bundle:release": "node tools/deploy-scripts/src/bundle-release.mjs",
    "emulators:start": "pnpm --filter @df/firebase-emulator ensure-ports && firebase emulators:start --project melody-r2-d4 --import packages/firebase-emulator/emulator-data --export-on-exit packages/firebase-emulator/emulator-data --only firestore,storage,functions",
    "emulators:clear": "pnpm --filter @df/firebase-emulator emulators:clear"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.35.0",
    "happy-dom": "^20.0.1",
    "husky": "^9.0.11",
    "playwright": "1.55.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.4",
    "rollup-plugin-summary": "^2.0.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "lit": "^3.3.1",
    "@types/chai": "4.3.20"
  }
}
