{
  "name": "@df/node-utils",
  "version": "0.0.0",
  "description": "Node.js utilities for dF extensions and tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "pnpm run build && node --test tests/**/*.test.js"
  },
  "keywords": ["node", "utilities", "env", "config"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@df/types": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "simple-git": "^3.32.3"
  }
}
